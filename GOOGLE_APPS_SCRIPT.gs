function respuesta(x){return ContentService.createTextOutput(JSON.stringify(x)).setMimeType(ContentService.MimeType.JSON)}
function configurarBaseDatos(){const libro=SpreadsheetApp.getActiveSpreadsheet();PropertiesService.getScriptProperties().setProperty('SPREADSHEET_ID',libro.getId());let h=libro.getSheetByName('PROGRAMACIONES')||libro.insertSheet('PROGRAMACIONES');if(!h.getLastRow())h.appendRow(['ID','FECHA','TURNO','DATOS','ACTUALIZADO']);h.getRange('A:E').setNumberFormat('@');h.setFrozenRows(1)}
function doGet(){return respuesta({ok:true,sistema:'FUNDO SANTA ROSA V39',estado:'CONECTADO'})}
function doPost(e){const lock=LockService.getScriptLock();try{lock.waitLock(30000);const q=JSON.parse(e.postData.contents);if(q.op==='login')return respuesta({data:login110_(q),error:null});const actor=auth110_(q);if(q.op==='logout'){CacheService.getScriptCache().remove('session:'+q.token);return respuesta({data:true,error:null})}const owner=actor==='ADMIN'&&['ADMIN','DIGITADOR1','DIGITADOR2'].includes(q.owner)?q.owner:actor;if(String(q.op).startsWith("ot_"))return respuesta({data:ordenes(q,owner),error:null});const h=SpreadsheetApp.openById(PropertiesService.getScriptProperties().getProperty('SPREADSHEET_ID')).getSheetByName('PROGRAMACIONES');const rows=h.getDataRange().getDisplayValues().slice(1);const f=q.filters||{};const match=r=>Object.keys(f).every(k=>r[k]===f[k]);const all=rows.map((r,i)=>({id:r[0],fecha:r[1],turno:r[2],datos:JSON.parse(r[3]),actualizado_en:r[4],owner:r[5]||'ADMIN',row:i+2}));const scoped=all.filter(r=>r.owner===owner);const found=scoped.filter(match);const valid=(d,t)=>{if(!/^\d{4}-\d{2}-\d{2}$/.test(d)||!['DÍA','NOCHE'].includes(t))throw Error('Fecha o turno inválido')};const pack=r=>{valid(r.fecha,r.turno);if(!Array.isArray(r.datos.items))throw Error('Datos inválidos');const s=JSON.stringify(r.datos);if(s.length>49000)throw Error('Programación supera el límite de una celda (49 000 caracteres)');return [(owner==='ADMIN'?'':owner+'|')+r.fecha+'|'+r.turno,r.fecha,r.turno,s,new Date().toISOString(),owner]};let data=null;if(q.op==='select'){data=found.map(({row,...r})=>r);if(q.single)data=data[0]||null}else if(q.op==='upsert'){const r=q.value;const v=pack(r);const old=scoped.find(x=>x.fecha===r.fecha&&x.turno===r.turno);h.getRange(old?old.row:h.getLastRow()+1,1,1,6).setNumberFormat('@').setValues([v])}else if(q.op==='update'){if(found.length!==1)throw Error('Registro no encontrado');const r={...found[0],...q.value};if(scoped.some(x=>x.row!==r.row&&x.fecha===r.fecha&&x.turno===r.turno))throw Error('Destino ocupado');h.getRange(r.row,1,1,6).setValues([pack(r)]);data=[{id:r.fecha+'|'+r.turno}]}else if(q.op==='delete'){if(!f.fecha||!f.turno)throw Error('Filtro requerido');found.reverse().forEach(r=>h.deleteRow(r.row))}else throw Error('Operación inválida');SpreadsheetApp.flush();return respuesta({data,error:null})}catch(err){return respuesta({data:null,error:{message:String(err.message||err)}})}finally{if(lock.hasLock())lock.releaseLock()}}

function ordenes(q,owner){const book=SpreadsheetApp.openById(PropertiesService.getScriptProperties().getProperty('SPREADSHEET_ID'));const h=book.getSheetByName('ORDENES_TRABAJO')||book.insertSheet('ORDENES_TRABAJO');if(!h.getLastRow())h.appendRow(['CORRELATIVO','FECHA','DATOS','ACTUALIZADO']);const rows=h.getDataRange().getDisplayValues().slice(1);const all=rows.map((r,i)=>({id:r[0],fecha:r[1],updated:r[3],owner:r[4]||'ADMIN',row:i+2}));const scoped=all.filter(r=>r.owner===owner);if(q.op==='ot_list')return scoped.reverse().map(r=>{if(!q.includeValues)return r;try{return {...r,values:JSON.parse(rows[r.row-2][2])}}catch(e){return r}});const old=scoped.find(r=>r.id===q.id);if(q.op==='ot_get'){if(!old)throw Error('OT no encontrada');return {id:old.id,values:JSON.parse(rows[old.row-2][2])}}if(q.op==='ot_delete'){if(!old)throw Error('OT no encontrada');if(!q.updated||q.updated!==old.updated)throw Error('La OT cambió. Actualiza el listado antes de eliminar');h.deleteRow(old.row);SpreadsheetApp.flush();return {deleted:old.id}}if(q.op!=='ot_save')throw Error('Operación inválida');if(q.id&&!old)throw Error('OT no encontrada');if(!q.values||typeof q.values!=='object')throw Error('Datos inválidos');const data=JSON.stringify(q.values);if(data.length>49000)throw Error('OT demasiado extensa');const requested=String(q.requestedId||'').trim();if(requested&&!/^\d{1,12}$/.test(requested))throw Error('Número OT inválido');if(!old&&requested&&all.some(r=>Number(r.id)===Number(requested)))throw Error('Ese número de OT ya existe');const id=old?old.id:requested||String(Math.max(0,...all.map(r=>Number(r.id)||0))+1).padStart(4,'0');h.getRange(old?old.row:h.getLastRow()+1,1,1,5).setNumberFormat('@').setValues([[id,String(q.values.C4||''),data,new Date().toISOString(),owner]]);SpreadsheetApp.flush();return {id:id}}

// Ejecutar una vez desde el editor privado de Apps Script. No publicar las claves.
function configurarUsuariosV110(){
 const props=PropertiesService.getScriptProperties();
 if(props.getProperty('users110'))throw Error('Usuarios ya configurados. No se modificaron.');
 const book=SpreadsheetApp.openById(props.getProperty('SPREADSHEET_ID'));
 const users={};const secret=Utilities.getUuid()+Utilities.getUuid();
 for(const name of ['ADMIN','DIGITADOR1','DIGITADOR2']){
  const pass=Utilities.getUuid().replace(/-/g,'')+Utilities.getUuid().slice(0,8);
  users[name]=hash110_(pass,secret+name);console.log(name+' : '+pass);
 }
 for(const [tab,col] of [['PROGRAMACIONES',6],['ORDENES_TRABAJO',5]]){
  const h=book.getSheetByName(tab);if(!h)continue;
  h.getRange(1,col).setValue('PROPIETARIO');
 }
 props.setProperties({users110:JSON.stringify(users),secret110:secret});
}
function hash110_(p,k){return Utilities.base64Encode(Utilities.computeHmacSha256Signature(p,k));}
function login110_(q){
 const p=PropertiesService.getScriptProperties();const users=JSON.parse(p.getProperty('users110')||'{}');const name=String(q.username||'').trim().toUpperCase();
 const cache=CacheService.getScriptCache();const key='attempt:'+name;const attempts=Number(cache.get(key)||0);
 if(attempts>=8)throw Error('Demasiados intentos. Espera 15 minutos.');
 if(!Object.prototype.hasOwnProperty.call(users,name)||users[name]!==hash110_(String(q.password||''),p.getProperty('secret110')+name)){if(Object.prototype.hasOwnProperty.call(users,name))cache.put(key,String(attempts+1),900);throw Error('Usuario o contraseña incorrectos');}
 cache.remove(key);const token=Utilities.getUuid()+Utilities.getUuid();cache.put('session:'+token,name,21600);return {token,username:name};
}
function auth110_(q){const token=String(q.token||'');const name=token.length===72?CacheService.getScriptCache().get('session:'+token):null;if(!name)throw Error('Sesión inválida o vencida');return name;}
