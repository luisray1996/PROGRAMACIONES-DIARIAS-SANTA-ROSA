function respuesta(x){return ContentService.createTextOutput(JSON.stringify(x)).setMimeType(ContentService.MimeType.JSON)}
function configurarBaseDatos(){const libro=SpreadsheetApp.getActiveSpreadsheet();PropertiesService.getScriptProperties().setProperty('SPREADSHEET_ID',libro.getId());let h=libro.getSheetByName('PROGRAMACIONES')||libro.insertSheet('PROGRAMACIONES');if(!h.getLastRow())h.appendRow(['ID','FECHA','TURNO','DATOS','ACTUALIZADO']);h.getRange('A:E').setNumberFormat('@');h.setFrozenRows(1)}
function doGet(){return respuesta({ok:true,sistema:'FUNDO SANTA ROSA V39',estado:'CONECTADO'})}
function doPost(e){const lock=LockService.getScriptLock();try{lock.waitLock(30000);const q=JSON.parse(e.postData.contents);if(String(q.op).startsWith("ot_"))return respuesta({data:ordenes(q),error:null});const h=SpreadsheetApp.openById(PropertiesService.getScriptProperties().getProperty('SPREADSHEET_ID')).getSheetByName('PROGRAMACIONES');const rows=h.getDataRange().getDisplayValues().slice(1);const f=q.filters||{};const match=r=>Object.keys(f).every(k=>r[k]===f[k]);const all=rows.map((r,i)=>({id:r[0],fecha:r[1],turno:r[2],datos:JSON.parse(r[3]),actualizado_en:r[4],row:i+2}));const found=all.filter(match);const valid=(d,t)=>{if(!/^\d{4}-\d{2}-\d{2}$/.test(d)||!['DÍA','NOCHE'].includes(t))throw Error('Fecha o turno inválido')};const pack=r=>{valid(r.fecha,r.turno);if(!Array.isArray(r.datos.items))throw Error('Datos inválidos');const s=JSON.stringify(r.datos);if(s.length>49000)throw Error('Programación supera el límite de una celda (49 000 caracteres)');return [r.fecha+'|'+r.turno,r.fecha,r.turno,s,new Date().toISOString()]};let data=null;if(q.op==='select'){data=found.map(({row,...r})=>r);if(q.single)data=data[0]||null}else if(q.op==='upsert'){const r=q.value;const v=pack(r);const old=all.find(x=>x.fecha===r.fecha&&x.turno===r.turno);h.getRange(old?old.row:h.getLastRow()+1,1,1,5).setNumberFormat('@').setValues([v])}else if(q.op==='update'){if(found.length!==1)throw Error('Registro no encontrado');const r={...found[0],...q.value};if(all.some(x=>x.row!==r.row&&x.fecha===r.fecha&&x.turno===r.turno))throw Error('Destino ocupado');h.getRange(r.row,1,1,5).setValues([pack(r)]);data=[{id:r.fecha+'|'+r.turno}]}else if(q.op==='delete'){if(!f.fecha||!f.turno)throw Error('Filtro requerido');found.reverse().forEach(r=>h.deleteRow(r.row))}else throw Error('Operación inválida');SpreadsheetApp.flush();return respuesta({data,error:null})}catch(err){return respuesta({data:null,error:{message:String(err.message||err)}})}finally{if(lock.hasLock())lock.releaseLock()}}

function ordenes(q){const book=SpreadsheetApp.openById(PropertiesService.getScriptProperties().getProperty('SPREADSHEET_ID'));const h=book.getSheetByName('ORDENES_TRABAJO')||book.insertSheet('ORDENES_TRABAJO');if(!h.getLastRow())h.appendRow(['CORRELATIVO','FECHA','DATOS','ACTUALIZADO']);const rows=h.getDataRange().getDisplayValues().slice(1);const all=rows.map((r,i)=>({id:r[0],fecha:r[1],updated:r[3],row:i+2}));if(q.op==='ot_list')return all.reverse();const old=all.find(r=>r.id===q.id);if(q.op==='ot_get'){if(!old)throw Error('OT no encontrada');return {id:old.id,values:JSON.parse(rows[old.row-2][2])}}if(q.op!=='ot_save')throw Error('Operación inválida');if(q.id&&!old)throw Error('OT no encontrada');if(!q.values||typeof q.values!=='object')throw Error('Datos inválidos');const data=JSON.stringify(q.values);if(data.length>49000)throw Error('OT demasiado extensa');const id=old?old.id:String(Math.max(0,...all.map(r=>Number(r.id)||0))+1).padStart(4,'0');h.getRange(old?old.row:h.getLastRow()+1,1,1,4).setNumberFormat('@').setValues([[id,String(q.values.C4||''),data,new Date().toISOString()]]);SpreadsheetApp.flush();return {id:id}}
